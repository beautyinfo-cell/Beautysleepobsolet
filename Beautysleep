    // =========================================================================
    // 6. QUICK-VIEW MODAL LOGIC
    // =========================================================================
    function openQuickView(productId) {
      const product = PRODUCTS.find(p => p.id === productId);
      if (!product) return;

      state.modalProduct = product;
      state.modalVariantIndex = 0;
      state.modalQty = 1;

      document.getElementById("modalBrand").textContent = product.brand;
      document.getElementById("modalBadge").textContent = product.badge;
      document.getElementById("modalProductTitle").textContent = product.name;
      document.getElementById("modalRating").textContent = product.rating.toFixed(1);
      document.getElementById("modalReviews").textContent = `(${product.reviews.toLocaleString()} reviews)`;
      document.getElementById("modalDescription").textContent = product.description;
      document.getElementById("modalHowToUse").textContent = `How to use: ${product.howToUse}`;
      document.getElementById("modalVisualContainer").innerHTML = renderProductSVG(product, true);

      // Ingredients pills
      document.getElementById("modalIngredients").innerHTML = product.ingredients.map(ing => `
        <span class="bg-white border border-espresso/10 text-espresso text-xs px-3 py-1 rounded-full">${ing}</span>
      `).join("");

      updateModalVariantUI();
      updateModalPriceAndQtyUI();

      const modal = document.getElementById("quickViewModal");
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function closeQuickView() {
      const modal = document.getElementById("quickViewModal");
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      document.body.style.overflow = "";
    }

    function selectModalVariant(idx) {
      state.modalVariantIndex = idx;
      updateModalVariantUI();
      updateModalPriceAndQtyUI();
    }

    function updateModalVariantUI() {
      const product = state.modalProduct;
      const selectedVariant = product.variants[state.modalVariantIndex];

      document.getElementById("modalVariantLabel").textContent = `Select ${product.variantType}`;
      document.getElementById("modalSelectedVariantName").textContent = selectedVariant.name;

      const optionsContainer = document.getElementById("modalVariantOptions");
      if (product.variantType === "Shade") {
        optionsContainer.innerHTML = product.variants.map((v, idx) => {
          const active = idx === state.modalVariantIndex;
          return `
            <button
              onclick="selectModalVariant(${idx})"
              class="flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-medium transition ${
                active ? "border-espresso bg-espresso text-cream" : "border-espresso/15 bg-white text-espresso hover:border-espresso/40"
              }"
            >
              <span class="w-4 h-4 rounded-full border border-white/60 shrink-0" style="background-color: ${v.swatch}"></span>
              <span>${v.name.split(" (")[0]}</span>
            </button>
          `;
        }).join("");
      } else {
        optionsContainer.innerHTML = product.variants.map((v, idx) => {
          const active = idx === state.modalVariantIndex;
          return `
            <button
              onclick="selectModalVariant(${idx})"
              class="px-3.5 py-1.5 rounded-full border text-xs font-medium transition ${
                active ? "border-espresso bg-espresso text-cream" : "border-espresso/15 bg-white text-espresso hover:border-espresso/40"
              }"
            >
              ${v.name}
            </button>
          `;
        }).join("");
      }
    }

    function adjustModalQty(delta) {
      state.modalQty = Math.max(1, Math.min(10, state.modalQty + delta));
      updateModalPriceAndQtyUI();
    }

    function updateModalPriceAndQtyUI() {
      const product = state.modalProduct;
      const variant = product.variants[state.modalVariantIndex];
      const unitPrice = product.price + (variant.priceDelta || 0);
      const lineTotal = unitPrice * state.modalQty;

      document.getElementById("modalPrice").textContent = formatAUD(unitPrice);
      document.getElementById("modalQtyDisplay").textContent = state.modalQty;
      document.getElementById("modalAddToCartBtn").textContent = `Add to Bag — ${formatAUD(lineTotal)}`;
    }

    function addModalProductToCart() {
      if (!state.modalProduct) return;
      addToCart(state.modalProduct.id, state.modalVariantIndex, state.modalQty);
      closeQuickView();
      openCart();
    }

    // =========================================================================
    // 7. SHOPPING CART DRAWER & SIMULATED CHECKOUT FLOW
    // =========================================================================
    function quickAddToCart(productId, event) {
      if (event) event.stopPropagation();
      addToCart(productId, 0, 1);
      const product = PRODUCTS.find(p => p.id === productId);
      showToast(`Added ${product.name} to your bag`, "success");
    }

    function addRoutineBundle() {
      // Adds Snail Mucin (1), Truffle Mist (2), Barrier Cream (5), Mineral SPF (6)
      [1, 2, 5, 6].forEach(id => addToCart(id, 0, 1));
      if (!state.appliedPromo) {
        state.appliedPromo = "GLOW15";
      }
      openCart();
      showToast("4-Step Glass Skin Routine added with GLOW15!", "success");
    }

    function addToCart(productId, variantIndex = 0, qty = 1) {
      const existing = state.cart.find(
        item => item.productId === productId && item.variantIndex === variantIndex
      );
      if (existing) {
        existing.qty += qty;
      } else {
        state.cart.push({ productId, variantIndex, qty });
      }
      state.checkoutStep = "cart";
      updateCartUI();
    }

    function updateCartItemQty(index, delta) {
      const item = state.cart[index];
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) {
        state.cart.splice(index, 1);
      }
      updateCartUI();
    }

    function removeCartItem(index) {
      state.cart.splice(index, 1);
      updateCartUI();
    }

    function openCart() {
      state.checkoutStep = "cart";
      updateCartUI();
      const drawer = document.getElementById("cartDrawer");
      drawer.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    }

    function closeCart() {
      const drawer = document.getElementById("cartDrawer");
      drawer.classList.add("hidden");
      document.body.style.overflow = "";
    }

    function applyPromoCode(event) {
      event.preventDefault();
      const input = document.getElementById("promoCodeInput");
      const code = input.value.trim().toUpperCase();
      if (!code) return;

      if (PROMO_CODES[code]) {
        state.appliedPromo = code;
        input.value = "";
        showToast(`Promo code ${code} applied!`, "success");
        updateCartUI();
      } else {
        showToast("Invalid code. Try GLOW15 or DEW10.");
      }
    }

    function removePromoCode() {
      state.appliedPromo = null;
      updateCartUI();
    }

    function calculateCartTotals() {
      const subtotal = state.cart.reduce((sum, item) => {
        const product = PRODUCTS.find(p => p.id === item.productId);
        const variant = product.variants[item.variantIndex] || product.variants[0];
        const unitPrice = product.price + (variant.priceDelta || 0);
        return sum + unitPrice * item.qty;
      }, 0);

      let discountAmount = 0;
      if (state.appliedPromo && PROMO_CODES[state.appliedPromo]) {
        discountAmount = subtotal * PROMO_CODES[state.appliedPromo].discount;
      }

      const afterDiscount = Math.max(0, subtotal - discountAmount);
      const freeShippingThreshold = 75.00;
      const shipping = afterDiscount === 0 || afterDiscount >= freeShippingThreshold ? 0 : 9.95;
      const total = afterDiscount + shipping;

      return {
        subtotal,
        discountAmount,
        afterDiscount,
        shipping,
        total,
        freeShippingThreshold
      };
    }

    function updateCartUI() {
      const totalItems = state.cart.reduce((sum, item) => sum + item.qty, 0);
      document.getElementById("cartCountBadge").textContent = totalItems;
      document.getElementById("drawerItemCount").textContent = `${totalItems} ${totalItems === 1 ? "item" : "items"}`;

      const totals = calculateCartTotals();

      // Free Shipping Progress Bar
      const progressPct = Math.min(100, (totals.afterDiscount / totals.freeShippingThreshold) * 100);
      document.getElementById("shippingProgressBar").style.width = `${progressPct}%`;
      const shippingText = document.getElementById("shippingProgressText");
      if (totals.afterDiscount >= totals.freeShippingThreshold) {
        shippingText.innerHTML = `<span class="text-emerald-700 font-semibold">&#10003; You've unlocked FREE Express AU Shipping!</span>`;
      } else {
        const remaining = totals.freeShippingThreshold - totals.afterDiscount;
        shippingText.innerHTML = `Add <span class="font-bold text-terracotta">${formatAUD(remaining)}</span> more for FREE Express AU Shipping`;
      }

      const bodyContainer = document.getElementById("cartBodyContainer");
      const footerContainer = document.getElementById("cartFooterContainer");

      // Handle Simulated Checkout Views
      if (state.checkoutStep === "form") {
        footerContainer.classList.add("hidden");
        renderCheckoutForm(bodyContainer, totals);
        return;
      }

      if (state.checkoutStep === "success") {
        footerContainer.classList.add("hidden");
        renderOrderConfirmation(bodyContainer);
        return;
      }

      // Standard Cart Items View
      if (state.cart.length === 0) {
        footerContainer.classList.add("hidden");
        bodyContainer.innerHTML = `
          <div class="h-full flex flex-col items-center justify-center text-center py-12 space-y-4">
            <div class="w-16 h-16 rounded-full bg-sand flex items-center justify-center text-taupe">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <div>
              <h3 class="font-serif text-2xl font-semibold text-espresso">Your bag is empty</h3>
              <p class="text-xs text-taupe mt-1 max-w-xs mx-auto">Explore our dermatologist-approved barrier care and viral dewy complexion picks.</p>
            </div>
            <button onclick="closeCart()" class="bg-espresso text-cream hover:bg-terracotta px-6 py-3 rounded-full text-xs font-semibold transition">
              Discover Bestsellers
            </button>
          </div>
        `;
        return;
      }

      footerContainer.classList.remove("hidden");

      bodyContainer.innerHTML = state.cart.map((item, idx) => {
        const product = PRODUCTS.find(p => p.id === item.productId);
        const variant = product.variants[item.variantIndex] || product.variants[0];
        const unitPrice = product.price + (variant.priceDelta || 0);

        return `
          <div class="flex gap-3.5 bg-white p-3.5 rounded-2xl border border-espresso/10">
            <div class="w-20 h-20 rounded-xl bg-sand/60 flex items-center justify-center shrink-0 overflow-hidden">
              <div class="scale-50">${renderProductSVG(product, false)}</div>
            </div>
            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div class="flex items-start justify-between gap-2">
                <div>
                  <p class="text-[10px] font-bold uppercase tracking-wider text-terracotta">${product.brand}</p>
                  <h4 class="font-serif text-base font-semibold text-espresso leading-tight truncate">${product.name}</h4>
                  <p class="text-xs text-taupe mt-0.5">${variant.name}</p>
                </div>
                <button onclick="removeCartItem(${idx})" aria-label="Remove item" class="text-taupe hover:text-espresso text-sm px-1">&times;</button>
              </div>

              <div class="flex items-center justify-between pt-2">
                <div class="flex items-center border border-espresso/15 rounded-full bg-cream px-1.5 py-0.5">
                  <button onclick="updateCartItemQty(${idx}, -1)" class="w-6 h-6 rounded-full hover:bg-sand text-xs font-bold">&minus;</button>
                  <span class="w-6 text-center text-xs font-semibold">${item.qty}</span>
                  <button onclick="updateCartItemQty(${idx}, 1)" class="w-6 h-6 rounded-full hover:bg-sand text-xs font-bold">+</button>
                </div>
                <span class="text-sm font-bold text-espresso">${formatAUD(unitPrice * item.qty)}</span>
              </div>
            </div>
          </div>
        `;
      }).join("");

      // Update Totals Display
      document.getElementById("cartSubtotal").textContent = formatAUD(totals.subtotal);
      document.getElementById("cartShipping").textContent = totals.shipping === 0 ? "FREE" : formatAUD(totals.shipping);
      document.getElementById("cartTotal").textContent = formatAUD(totals.total);

      const discountRow = document.getElementById("discountRow");
      const promoFeedback = document.getElementById("promoFeedback");

      if (state.appliedPromo && PROMO_CODES[state.appliedPromo]) {
        discountRow.classList.remove("hidden");
        document.getElementById("discountLabel").textContent = PROMO_CODES[state.appliedPromo].label;
        document.getElementById("cartDiscount").textContent = `-${formatAUD(totals.discountAmount)}`;

        promoFeedback.classList.remove("hidden");
        document.getElementById("promoMessage").textContent = `Code ${state.appliedPromo} applied!`;
      } else {
        discountRow.classList.add("hidden");
        promoFeedback.classList.add("hidden");
      }
    }

    function startSimulatedCheckout() {
      if (state.cart.length === 0) return;
      state.checkoutStep = "form";
      updateCartUI();
    }

    function backToCartItems() {
      state.checkoutStep = "cart";
      updateCartUI();
    }

    function renderCheckoutForm(container, totals) {
      container.innerHTML = `
        <div class="space-y-5">
          <button onclick="backToCartItems()" class="text-xs font-semibold text-taupe hover:text-espresso flex items-center gap-1">
