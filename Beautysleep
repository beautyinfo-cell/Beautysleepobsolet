            <button type="submit" class="w-full bg-espresso hover:bg-terracotta text-cream font-semibold py-3.5 rounded-full text-sm transition shadow-md mt-2">
              Complete Order &mdash; ${formatAUD(totals.total)}
            </button>
          </form>
        </div>
      `;
    }

    function submitSimulatedOrder(event) {
      event.preventDefault();
      state.cart = [];
      state.appliedPromo = null;
      state.checkoutStep = "success";
      updateCartUI();
    }

    function renderOrderConfirmation(container) {
      const orderNum = "AD-" + Math.floor(100000 + Math.random() * 900000);
      container.innerHTML = `
        <div class="h-full flex flex-col items-center justify-center text-center py-10 space-y-4">
          <div class="w-16 h-16 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-2xl font-bold">
            &#10003;
          </div>
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-widest text-terracotta">Order Confirmed</span>
            <h3 class="font-serif text-3xl font-semibold text-espresso">Thank you for glowing with us!</h3>
            <p class="text-xs text-taupe">Order Reference: <strong class="text-espresso">${orderNum}</strong></p>
