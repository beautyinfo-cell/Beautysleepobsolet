      showToast("Welcome to AURA & DEW! Use GLOW15 at checkout.", "success");
    }

    // =========================================================================
    // 8. EVENT LISTENERS & INITIALIZATION
    // =========================================================================
    function syncSearchInputs(value) {
      state.searchQuery = value;
      document.getElementById("desktopSearchInput").value = value;
      document.getElementById("mobileSearchInput").value = value;

      const hasVal = value.trim().length > 0;
      document.getElementById("clearDesktopSearch").classList.toggle("hidden", !hasVal);
      document.getElementById("clearMobileSearch").classList.toggle("hidden", !hasVal);

      renderProducts();
    }

    window.addEventListener("DOMContentLoaded", () => {
      document.getElementById("desktopSearchInput").addEventListener("input", e => syncSearchInputs(e.target.value));
      document.getElementById("mobileSearchInput").addEventListener("input", e => syncSearchInputs(e.target.value));

      // Escape key closes modals/drawers
      document.addEventListener("keydown", e => {
        if (e.key === "Escape") {
          closeQuickView();
          closeCart();
        }
      });

      renderCategoryTabs();
      updateWishlistHeaderUI();
      renderProducts();
      updateCartUI();
    });
