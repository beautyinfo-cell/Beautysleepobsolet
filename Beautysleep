    // =========================================================================
    // 4. FORMATTERS & TOAST NOTIFICATIONS
    // =========================================================================
    function formatAUD(amount) {
      return `$${amount.toFixed(2)} AUD`;
    }

    function showToast(message, type = "default") {
      const container = document.getElementById("toastContainer");
      const toast = document.createElement("div");
      const bgClass = type === "success" ? "bg-emerald-800 text-white" : "bg-espresso text-cream";
      toast.className = `${bgClass} px-5 py-3 rounded-full shadow-xl text-xs sm:text-sm font-medium flex items-center gap-2 transition-all duration-300 transform translate-y-2 opacity-0`;
      toast.innerHTML = `<span>${message}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove("translate-y-2", "opacity-0");
      });

      setTimeout(() => {
        toast.classList.add("opacity-0", "translate-y-2");
        setTimeout(() => toast.remove(), 300);
      }, 2800);
    }

    function copyPromoCode(code) {
      const tempInput = document.createElement("input");
      tempInput.value = code;
      document.body.appendChild(tempInput);
      tempInput.select();
      try {
        document.execCommand("copy");
        showToast(`Copied promo code ${code} to clipboard!`, "success");
      } catch (e) {
        showToast(`Promo code: ${code}`);
      }
      document.body.removeChild(tempInput);
    }

    // =========================================================================
    // 5. CATEGORY TABS, SEARCH & PRODUCT GRID RENDERING
    // =========================================================================
    function renderCategoryTabs() {
      const container = document.getElementById("categoryTabs");
      container.innerHTML = CATEGORIES.map(cat => {
        const isActive = state.selectedCategory === cat && !state.wishlistOnly;
        return `
          <button
            onclick="selectCategory('${cat}')"
            class="px-4 py-1.5 rounded-full text-xs sm:text-sm font-medium whitespace-nowrap transition ${
              isActive
                ? "bg-espresso text-cream shadow-xs"
                : "bg-transparent text-taupe hover:bg-sand hover:text-espresso"
            }"
          >
            ${cat}
          </button>
        `;
      }).join("");
    }

    function selectCategory(category) {
      state.selectedCategory = category;
      state.wishlistOnly = false;
      updateWishlistHeaderUI();
      renderCategoryTabs();
      renderProducts();
    }

    function handleSortChange(val) {
      state.sortBy = val;
      document.getElementById("sortSelect").value = val;
      document.getElementById("mobileSortSelect").value = val;
      renderProducts();
    }

    function clearSearch() {
      state.searchQuery = "";
      document.getElementById("desktopSearchInput").value = "";
      document.getElementById("mobileSearchInput").value = "";
      document.getElementById("clearDesktopSearch").classList.add("hidden");
      document.getElementById("clearMobileSearch").classList.add("hidden");
      renderProducts();
    }

    function resetFilters() {
      state.selectedCategory = "All";
      state.searchQuery = "";
      state.wishlistOnly = false;
      state.sortBy = "featured";
      document.getElementById("desktopSearchInput").value = "";
      document.getElementById("mobileSearchInput").value = "";
      document.getElementById("clearDesktopSearch").classList.add("hidden");
      document.getElementById("clearMobileSearch").classList.add("hidden");
      document.getElementById("sortSelect").value = "featured";
      document.getElementById("mobileSortSelect").value = "featured";
      updateWishlistHeaderUI();
      renderCategoryTabs();
      renderProducts();
    }

    function toggleWishlist(productId, event) {
      if (event) event.stopPropagation();
      const idx = state.wishlist.indexOf(productId);
      const product = PRODUCTS.find(p => p.id === productId);
      if (idx > -1) {
        state.wishlist.splice(idx, 1);
        showToast(`Removed ${product.name} from saved items`);
      } else {
        state.wishlist.push(productId);
        showToast(`Saved ${product.name} to favorites`);
      }
      updateWishlistHeaderUI();
      renderProducts();
    }

    function toggleWishlistFilter() {
      state.wishlistOnly = !state.wishlistOnly;
      updateWishlistHeaderUI();
      renderCategoryTabs();
      renderProducts();
      if (state.wishlistOnly) {
        document.getElementById("catalogSection").scrollIntoView({ behavior: "smooth" });
      }
    }

    function updateWishlistHeaderUI() {
      const badge = document.getElementById("wishlistCountBadge");
      const icon = document.getElementById("headerHeartIcon");
      const btn = document.getElementById("wishlistToggleBtn");

      if (state.wishlist.length > 0) {
        badge.textContent = state.wishlist.length;
        badge.classList.remove("hidden");
      } else {
        badge.classList.add("hidden");
      }

      if (state.wishlistOnly) {
        btn.classList.add("bg-blush/70");
        icon.setAttribute("fill", "#C86D58");
        icon.setAttribute("stroke", "#C86D58");
      } else {
        btn.classList.remove("bg-blush/70");
        icon.setAttribute("fill", "none");
        icon.setAttribute("stroke", "currentColor");
      }
    }

    function getFilteredProducts() {
      let list = [...PRODUCTS];

      if (state.wishlistOnly) {
        list = list.filter(p => state.wishlist.includes(p.id));
      } else if (state.selectedCategory === "Bestsellers") {
        list = list.filter(p => p.bestseller);
      } else if (state.selectedCategory !== "All") {
        list = list.filter(p => p.category === state.selectedCategory);
      }

      if (state.searchQuery.trim() !== "") {
        const q = state.searchQuery.toLowerCase().trim();
        list = list.filter(p =>
          p.name.toLowerCase().includes(q) ||
          p.brand.toLowerCase().includes(q) ||
          p.category.toLowerCase().includes(q) ||
          p.description.toLowerCase().includes(q) ||
          p.ingredients.some(ing => ing.toLowerCase().includes(q))
        );
      }

      switch (state.sortBy) {
        case "rating":
          list.sort((a, b) => b.rating - a.rating || b.reviews - a.reviews);
          break;
        case "price-asc":
          list.sort((a, b) => a.price - b.price);
          break;
        case "price-desc":
          list.sort((a, b) => b.price - a.price);
          break;
        default:
          // Featured: bestsellers first
          list.sort((a, b) => (b.bestseller === a.bestseller ? 0 : b.bestseller ? 1 : -1));
      }

      return list;
    }

    function renderProducts() {
      const grid = document.getElementById("productGrid");
      const emptyState = document.getElementById("emptyState");
      const countLabel = document.getElementById("productCountLabel");
      const titleEl = document.getElementById("catalogTitle");
      const eyebrowEl = document.getElementById("catalogEyebrow");
      const activeBar = document.getElementById("activeFilterBar");
      const activeChips = document.getElementById("activeFilterChips");

      const filtered = getFilteredProducts();

      // Update Headings
      if (state.wishlistOnly) {
        eyebrowEl.textContent = "Personal Edit";
        titleEl.textContent = "Your Saved Favorites";
      } else if (state.selectedCategory === "All") {
        eyebrowEl.textContent = "Curated Edit";
        titleEl.textContent = "All Trending Beauty";
      } else {
        eyebrowEl.textContent = "Category Spotlight";
        titleEl.textContent = state.selectedCategory;
      }

      countLabel.textContent = `Showing ${filtered.length} ${filtered.length === 1 ? "product" : "products"}`;

      // Active Filter Chips
      const chips = [];
      if (state.searchQuery.trim() !== "") {
        chips.push(`<span class="bg-sand text-espresso text-xs px-3 py-1 rounded-full flex items-center gap-1.5">Search: "${state.searchQuery}" <button onclick="clearSearch()" class="font-bold hover:text-terracotta">&times;</button></span>`);
      }
      if (state.wishlistOnly) {
        chips.push(`<span class="bg-blush/70 text-espresso text-xs px-3 py-1 rounded-full flex items-center gap-1.5">Saved Items Only <button onclick="toggleWishlistFilter()" class="font-bold hover:text-terracotta">&times;</button></span>`);
      }

      if (chips.length > 0) {
        activeChips.innerHTML = chips.join("");
        activeBar.classList.remove("hidden");
        activeBar.classList.add("flex");
      } else {
        activeBar.classList.add("hidden");
        activeBar.classList.remove("flex");
      }

      // Render Grid or Empty State
      if (filtered.length === 0) {
        grid.innerHTML = "";
        emptyState.classList.remove("hidden");
        return;
      }

      emptyState.classList.add("hidden");

      grid.innerHTML = filtered.map(product => {
        const isSaved = state.wishlist.includes(product.id);
        const shadeDots = product.variantType === "Shade"
          ? `<div class="flex items-center gap-1.5 mt-2">
              ${product.variants.map(v => `<span class="w-3.5 h-3.5 rounded-full border border-espresso/20" style="background-color: ${v.swatch}" title="${v.name}"></span>`).join("")}
              <span class="text-[11px] text-taupe ml-1">${product.variants.length} shades</span>
             </div>`
          : `<p class="text-[11px] text-taupe mt-2">${product.variants[0].name} &bull; ${product.ingredients[0]}</p>`;

        return `
          <article onclick="openQuickView(${product.id})" class="group bg-white rounded-3xl border border-espresso/10 overflow-hidden flex flex-col justify-between hover:shadow-xl hover:border-espresso/20 transition-all duration-300 cursor-pointer">
            <!-- Top Visual Box -->
            <div class="relative bg-sand/60 p-6 flex items-center justify-center h-60 overflow-hidden">
              <!-- Badge -->
              <span class="absolute top-3.5 left-3.5 bg-white/95 backdrop-blur-xs text-espresso text-[11px] font-semibold px-3 py-1 rounded-full shadow-2xs">
                ${product.badge}
              </span>

              <!-- Wishlist Button -->
              <button
                onclick="toggleWishlist(${product.id}, event)"
                aria-label="Save ${product.name}"
                class="absolute top-3.5 right-3.5 w-9 h-9 rounded-full bg-white/90 hover:bg-white flex items-center justify-center shadow-2xs transition"
              >
                <svg class="w-4 h-4 ${isSaved ? 'text-terracotta fill-terracotta' : 'text-espresso'}" fill="${isSaved ? 'currentColor' : 'none'}" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
              </button>

              <!-- SVG Bottle Art -->
              ${renderProductSVG(product, false)}

              <!-- Hover Quick View Pill -->
              <span class="absolute bottom-3 opacity-0 group-hover:opacity-100 translate-y-2 group-hover:translate-y-0 transition-all duration-300 bg-espresso/90 text-cream text-xs font-medium px-4 py-1.5 rounded-full">
                Quick View &amp; Ingredients
              </span>
            </div>

            <!-- Card Details -->
            <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center justify-between gap-2 mb-1">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-terracotta">${product.brand}</span>
                  <div class="flex items-center gap-1 text-xs font-medium text-espresso">
                    <span class="text-amber-500">&#9733;</span>
                    <span>${product.rating.toFixed(1)}</span>
                    <span class="text-taupe">(${product.reviews.toLocaleString()})</span>
                  </div>
                </div>
                <h3 class="font-serif text-xl font-semibold text-espresso leading-snug group-hover:text-terracotta transition">
                  ${product.name}
                </h3>
                ${shadeDots}
              </div>

              <!-- Price & Quick Add -->
              <div class="pt-3 border-t border-espresso/10 flex items-center justify-between gap-2">
