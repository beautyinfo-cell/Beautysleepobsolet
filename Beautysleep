              <div>
                <label class="block text-xs font-semibold text-espresso mb-1">State &amp; Postcode</label>
                <input type="text" required value="VIC 3000" class="w-full bg-white border border-espresso/15 rounded-xl px-3.5 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-terracotta" />
              </div>
            </div>

            <div class="bg-sand/80 p-3.5 rounded-2xl border border-espresso/10 space-y-2">
              <p class="text-xs font-semibold text-espresso">Payment Method (Demo)</p>
